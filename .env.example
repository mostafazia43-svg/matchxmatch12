# ============================================================================
# Click Battle - environment template.  Copy to .env and fill in.
# NEVER commit .env. NEVER put private keys or seed phrases in source files.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- telegram
# From @BotFather. Server-side only - never exposed to the frontend.
BOT_TOKEN=8727645123:AAHUqDb-DI8KroDpsBH5nLCNWxH8BFLCQAs
BOT_USERNAME=ClickspeedUSDTBot
# Comma-separated Telegram user IDs with admin access.
ADMIN_TELEGRAM_IDS=901505210
# Public HTTPS URL of the Mini App (required by Telegram in production).
MINI_APP_URL=https://solid-bassoon-7v4ww9gvw4j4fxwq4-5173.app.github.dev/
# Set to run the bot on webhooks instead of long polling.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# ---------------------------------------------------------------- server
PORT=8080
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:8080
# Comma-separated allowed browser origins for the Mini App.
CORS_ORIGINS=http://localhost:5173,https://your-domain.example
# 32+ random bytes. Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48
JWT_TTL_SECONDS=86400
# Reject initData older than this (Telegram replay window).
AUTH_INITDATA_MAX_AGE_SECONDS=86400
# Set true ONLY for local UI work without Telegram. Never enable in production.
ALLOW_DEV_AUTH=false
DEV_AUTH_SECRET=

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://clickbattle:clickbattle@localhost:5432/clickbattle
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ---------------------------------------------------------------- redis
# Leave empty to use the in-process driver (single-instance dev only).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- ton / usdt
# Platform receiving address (public - safe to expose).
PLATFORM_WALLET_ADDRESS=UQB7KW1CvQ_pFqbaRyUYpOi31t4oEdjRWHsOpBWbkwFQYu4J
TON_NETWORK=mainnet
# USDT jetton master on TON (mainnet).
USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
USDT_DECIMALS=6

# Deposit/withdrawal provider: mock | tonapi
# 'mock' performs NO chain calls - it is for local development and tests only.
TON_PROVIDER=mock
TONAPI_BASE_URL=https://tonapi.io
TONAPI_KEY=
# Poll interval for the deposit watcher.
DEPOSIT_POLL_INTERVAL_MS=20000

# Outbound withdrawal signing. Leave EMPTY to keep withdrawals manual
# (admin approves, then pays out by hand) - this is the safe default.
# If you enable automated payouts, inject this from a secrets manager,
# NEVER from a file committed to the repo.
TON_PAYOUT_MNEMONIC=
TON_PAYOUT_ENABLED=false

# ---------------------------------------------------------------- limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
WS_MAX_CONNECTIONS_PER_USER=3
