{
  "name": "clickbattle",
  "version": "1.0.0",
  "private": true,
  "description": "Click Battle - Telegram Mini App: real-time 1v1 reaction duels (Free / Paid USDT-TON / Demo)",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/bot",
    "packages/frontend"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w @cb/shared && npm run build -w @cb/backend && npm run build -w @cb/bot && npm run build -w @cb/frontend",
    "dev": "npm run dev -w @cb/backend",
    "dev:web": "npm run dev -w @cb/frontend",
    "dev:bot": "npm run dev -w @cb/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate -w @cb/backend",
    "seed": "npm run seed -w @cb/backend"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
